# Copy to .env and fill in. .env is not committed.

# TMDB API key (https://www.themoviedb.org/settings/api), used by the cast collectors.
TMDB_API_KEY=your_key_here

# Neo4j (started with `docker compose up -d`). Pick any password of 8+ characters;
# docker-compose.yml reads it from this file to create the database user.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=choose_a_password

# OpenRouter (https://openrouter.ai/keys), used by src/retrieval for embeddings and answers.
# Changing EMBEDDING_MODEL means embedding every passage, fact and summary again.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
QA_MODEL=openai/gpt-6-luna
